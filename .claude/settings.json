{
  "permissions": {
    "allow": [
      "Bash(python3 -m unittest)",
      "Bash(python3 -m unittest *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)"
    ],
    "deny": [
      "Read(./.env)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/scripts/stop_gate.py\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}